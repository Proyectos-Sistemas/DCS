                                        @Html.ValidationMessageFor(model => model.ArchivoAdjunto, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="row  m-t-lg m-b-lg">
                            <div class="text-center col-lg-3">
                                <i class="pe-7s-check fa-5x text-muted"></i>
                                <p class="small m-t-md">
                                    Completa el <strong>Captcha</strong> para enviar la solicitud
                                </p>
                            </div>
                            <div class="col-lg-3">
                            </div>
                            <div class="col-lg-3 text-center">
                                <br />
                                @Html.RecaptchaApiScript()
                                <!-- Render recaptcha widget with default properties. -->
                                @Html.RecaptchaWidget(renderApiScript: false)
                                @Html.ValidationMessage("captcha", new { @class = "text-danger" })

                            </div>
                            <div class="col-lg-3">
                            </div>
                        </div>
                        <div class="row text-center m-t-lg m-b-lg">
                            <div class="col-lg-4">
                            </div>

                        </div>
                        <div class="row text-center m-t-lg m-b-lg">
                            <div class="col-lg-12">

                            </div>
                        </div>
                        <div class="text-right m-t-xs">
                            @*<a class="btn btn-default prev" href="#">Anterior</a>
                                <a class="btn btn-default next" href="#">Siguiente</a>*@
                            @*<a class="btn btn-success submitWizard" href="#">Enviar</a>*@
                            <input type="submit" value="Enviar" class="btn btn-success submitWizard" />
                        </div>


                    </div>
                </div>
            </div>

        </div>
    </div>
}

@section Scripts {


    <script type="text/javascript">


        $(function () {


            $('#Nombre_Departamento').chosen();
            $('#Nombre_Producto').chosen();



            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                $('a[data-toggle="tab"]').removeClass('btn-primary');
                $('a[data-toggle="tab"]').addClass('btn-default');
                $(this).removeClass('btn-default');
                $(this).addClass('btn-primary');
            })

            $('.next').click(function () {
                var nextId = $(this).parents('.tab-pane').next().attr("id");
                $('[href=#' + nextId + ']').tab('show');
            })

            $('.prev').click(function () {
                var prevId = $(this).parents('.tab-pane').prev().attr("id");
                $('[href=#' + prevId + ']').tab('show');
            })


            //document.getElementById("Nombre_Categoria_chosen").style.width = "300px";
            //document.getElementById("Nombre_Producto_chosen").style.width = "300px";

            $("#Nombre_Departamento").change(function () {
                $.get("/ServiceE/GetProductosList",
                    { departamentoId: $("#Nombre_Departamento").val() },
                    function (data) {
                        $("#Nombre_Producto").empty();
                        $("#Nombre_Producto").append("<option value>     </option>");
                        $.each(data, function (index, row) {
                            $("#Nombre_Producto").append("<option value='" + row.ID_PRODUCTO + "'>" + row.NOMBRE_PRODUCTO + "</option>");
                        });
                        $('#Nombre_Producto').trigger("chosen:updated");
                    });
            });

