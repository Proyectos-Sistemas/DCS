@model  Homer_MVC.Models.MailExt

@{
    ViewBag.Title = "Solicitud de Servicio";
}

@using Recaptcha.Web.Mvc;

@using (Html.BeginForm("ServiceERequest", "ServiceE", FormMethod.Post, new { enctype = "multipart/form-data", id = "simpleForm" }))
